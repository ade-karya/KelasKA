# Env minimal untuk host serverless (Vercel / Cloudflare Containers).
# Salin nilai ke dashboard platform atau ke `wrangler secret put`, JANGAN ke
# .env.local di repo. Variabel NEXT_PUBLIC_* di-inline saat build: ubah lalu
# rebuild. Lihat deploy/README.md untuk arsitektur worker eksternal.

# "vercel" juga terdeteksi otomatis dari VERCEL=1. Pada Cloudflare Containers,
# nilai ini disuntikkan worker.ts saat container start (bukan saat build image).
OPENMAIC_DEPLOY_TARGET=vercel

# WAJIB. Pakai connection pooler (Supabase port 6543 / Neon pooled) karena
# setiap instance fungsi membuka pool pg-nya sendiri. Nilai ini HARUS sama
# dengan host worker.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# WAJIB. Menandatangani session cookie dan menyegel kunci model yang disimpan
# pengguna. Sama persis dengan worker, kalau tidak cookie tidak tervalidasi.
OPENMAIC_SECRET_KEY=replace-with-a-long-random-string

# --- Salah satu pintu masuk (pilih sesuai deployment) -----------------------
# Opsi A — kode akses bersama:
ACCESS_CODE=replace-with-a-long-random-code
# Opsi B — akun Google lewat Supabase Auth (ACCESS_CODE diabaikan saat
# AUTH_ENABLED=true). Semua NEXT_PUBLIC_* berikut harus ada saat build.
# AUTH_ENABLED=true
# AUTH_SECRET=replace-with-another-long-random-string
# AUTH_PUBLIC_URL=https://kelaska.riau.ai
# AUTH_ADMIN_EMAILS=admin@sekolah.id
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_PERSISTENCE=1

# --- Model / penyimpanan ----------------------------------------------------
# Provider cloud saja. Jangan isi endpoint GPU lokal di host serverless.
GOOGLE_API_KEY=
GOOGLE_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
# Asset dan material harus memakai byte store bersama, bukan ./data.
HF_S3_BUCKET=
HF_S3_ENDPOINT=
HF_S3_REGION=us-east-1
HF_S3_ACCESS_KEY_ID=
HF_S3_SECRET_ACCESS_KEY=

# TTS browser-native memakai speechSynthesis di perangkat pengunjung; tidak
# butuh GPU server. Matikan penyedia media lokal.
TTS_BROWSER_NATIVE_ENABLED=true
IMAGE_COMFYUI_ENABLED=false

# Jangan aktifkan runner di sini — worker eksternal yang menjalankan generasi.
# OPENMAIC_AGENT_RUNTIME_ENABLED=false

# --- Pemicu worker Kaggle (Hobby: dipakai function deploy/spa/api) ----------
# Backend yang meneruskan /api/* dari SPA (Cloudflare Worker yang sudah ada).
SPLIT_BACKEND_ORIGIN=https://kelaska.riau.ai
# Kredensial Kaggle API (kaggle.json -> username/key, atau token KGAT_...).
# Keduanya dipakai function /api/kaggle/wake untuk SaveKernel + run kernel.
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_KERNEL_REF=akjdev/kelaska-worker
KAGGLE_SESSION_TIMEOUT_SECONDS=14400
