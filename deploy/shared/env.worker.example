# Env minimal untuk host worker (Kaggle / Colab / VPS).
# Host ini menjalankan build penuh dan mengklaim generation run yang dibuat
# oleh deployment serverless. Lihat deploy/worker/README.md.

# "self-hosted" (default), "kaggle" atau "colab". Jangan pakai vercel/cloudflare
# di sini: itu akan mematikan runner.
OPENMAIC_DEPLOY_TARGET=self-hosted

# WAJIB sama persis dengan host serverless. Ini satu-satunya "kabel" antar host:
# antrean run dan event progres keduanya dibaca dari database ini.
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres?sslmode=require
OPENMAIC_SECRET_KEY=same-value-as-the-serverless-host

# Byte store yang sama dengan host serverless, supaya gambar/audio hasil
# generasi bisa dibaca oleh UI di Vercel/Cloudflare.
HF_S3_BUCKET=
HF_S3_ENDPOINT=
HF_S3_REGION=us-east-1
HF_S3_ACCESS_KEY_ID=
HF_S3_SECRET_ACCESS_KEY=

# Worker membutuhkan kunci model untuk menjalankan tiap langkah generasi.
GOOGLE_API_KEY=
GOOGLE_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
NEXT_PUBLIC_PERSISTENCE=1
OPENMAIC_AGENT_RUNTIME_ENABLED=true

# Akses/kredensial akun harus sama bila serverless memakai akun:
# AUTH_ENABLED=true
# AUTH_SECRET=same-as-serverless
# ACCESS_CODE=same-as-serverless
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# --- Opsional: layanan GPU lokal -------------------------------------------
# Hanya isi endpoint yang lolos health check di host ini. INSTALLER menulis
# ini otomatis saat menjalankan install.sh --kaggle / --colab dengan NVIDIA GPU.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# ASR_FUNASR_BASE_URL=http://127.0.0.1:8000
# TTS_VOXCPM_BASE_URL=... (jangan dipakai; VoxCPM lewat openmaic.yml)
# IMAGE_COMFYUI_ENABLED=true
# OPENMAIC_AGENT_TTS_CONCURRENCY=2
# OPENMAIC_GENERATION_RUN_MAX_CONCURRENT=4

# Kaggle/Colab: runtime bersifat sementara. `install.sh` menulis .env.local
# dan openmaic.yml ke direktori kerja; cadangkan keduanya sebelum menutup
# notebook, atau pakai DATABASE_URL + HF_S3_* eksternal seperti di atas.
