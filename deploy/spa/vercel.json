{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/__kelaska/:path*",
      "destination": "https://kelaska.riau.ai/__kelaska/:path*"
    },
    {
      "source": "/api/:a/:b/:c",
      "destination": "/api/:a~:b~:c"
    },
    {
      "source": "/api/:a/:b",
      "destination": "/api/:a~:b"
    }
  ]
}
