{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/__kelaska/:path*",
      "destination": "https://kelaska.riau.ai/__kelaska/:path*"
    }
  ]
}
