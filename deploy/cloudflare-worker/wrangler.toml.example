# KelasKA edge Worker — Cloudflare Workers + KV + Durable Object.
#
# Copy this file to wrangler.toml, then fill the KV namespace id and the
# deployment-specific origins. `wrangler.toml` is git-ignored because it
# carries account ids; the secrets are set with `wrangler secret put`.
name = "kelaska-edge"
main = "src/index.ts"
compatibility_date = "2026-11-01"

# The Worker must run in front of the app hostname. Keep the DNS record
# proxied (orange cloud); the Worker route takes precedence over its origin.
routes = [
  { pattern = "kelaska.riau.ai/*", zone_name = "riau.ai" }
]

workers_dev = false

[vars]
ENVIRONMENT = "production"
# Leave "0" while the full app is still served from Colab. Set to "1" only
# after the SPA is deployed on Vercel: pages then come from VERCEL_ORIGIN and
# /api/* from the live session, and the Worker answers /api/session/start.
STATIC_UI_ENABLED = "0"
# Kaggle app session origin (tunnel to the kernel running the Next.js app).
# Older deployments leave this unset and keep replaying to COLAB_ORIGIN.
SESSION_APP_ORIGIN = "https://app.kelaska.riau.ai"
SESSION_START_USER_COOLDOWN_SECONDS = "600"
SESSION_START_GLOBAL_COOLDOWN_SECONDS = "120"
# The Vercel deployment that serves the UI (static status page or the SPA).
VERCEL_ORIGIN = "https://kelaska.vercel.app"
# Cloudflare Tunnel hostnames. Both are protected by Cloudflare Access and
# are only called by this Worker (and by the Colab GPU proxy).
COLAB_ORIGIN = "https://api.kelaska.riau.ai"
GPU_ORIGIN = "https://gpu.kelaska.riau.ai"
# Kaggle kernel that runs the GPU services. The Worker pushes the script from
# KERNEL_SOURCE_URL as a new version, so the kernel stays versioned in git.
# SaveKernel's `slug` is the full owner/kernel-slug ref, so keep the owner here.
KAGGLE_KERNEL_REF = "akjdev/kelaska-gpu"
KAGGLE_KERNEL_TITLE = "KelasKA GPU"
KAGGLE_DATASET = "akjdev/kelaska-gpu-models"
KAGGLE_MACHINE_SHAPE = "NvidiaTeslaT4"
# Must be lower than Kaggle's 12 h session cap; the kernel also exits itself
# at 11 h 40 m (42000 s), so the two backstops agree.
KAGGLE_SESSION_TIMEOUT_SECONDS = "42000"
KAGGLE_COOLDOWN_SECONDS = "900"
KERNEL_SOURCE_URL = "https://raw.githubusercontent.com/ade-karya/KelasKA/Colab/deploy/kaggle/kelaska-gpu.py"
# Stop an idle Kaggle session after 30 minutes without a GPU request. The
# kernel polls the lease endpoint and exits itself; the Kaggle session then
# ends and stops consuming the weekly GPU quota.
GPU_IDLE_STOP_SECONDS = "1800"

[[kv_namespaces]]
binding = "STATE"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[[durable_objects.bindings]]
name = "COORDINATOR"
class_name = "Coordinator"

# Workers Free requires SQLite-backed Durable Objects.
[[migrations]]
tag = "v1"
new_sqlite_classes = ["Coordinator"]

[triggers]
crons = ["*/2 * * * *"]

# Secrets (set with `wrangler secret put <NAME>`):
#   CF_ACCESS_CLIENT_ID       Cloudflare Access service token for api./gpu.
#   CF_ACCESS_CLIENT_SECRET
#   KAGGLE_USERNAME           Kaggle username from kaggle.json, NOT the Gmail address
#                             used to sign in to Kaggle.
#   KAGGLE_KEY                Kaggle API key (kaggle.json "key"); create it in
#                             Kaggle -> Settings -> API -> Create New Token.
#   EDGE_ADMIN_TOKEN          Bearer token for /__kelaska/admin/*.
#   GPU_LEASE_KEY             Shared with the Kaggle kernel; guards the lease.
#   SUPABASE_URL              Supabase project URL (same as NEXT_PUBLIC_*).
#   SUPABASE_ANON_KEY         Anon/publishable key; verifies /api/session/start
#                             via GET /auth/v1/user while the app is asleep.
