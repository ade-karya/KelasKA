# Vercel web tier — salin ke Environment Variables di Project Settings.
# Jangan pernah menaruh SUPABASE_SERVICE_ROLE_KEY di variabel NEXT_PUBLIC_*.

# --- Database (Supabase session pooler, PORT 5432 untuk LISTEN/NOTIFY) ---
DATABASE_URL=postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgres://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth ---
AUTH_ENABLED=true
AUTH_PUBLIC_URL=https://kelas-ka.riau.ai
AUTH_ADMIN_EMAILS=admin@dinas.belajar.id
OPENMAIC_SECRET_KEY=<minimal-32-karakter-acak>
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<server-only-jangan-di-client>

# --- Model ---
GOOGLE_API_KEY=<gemini-key>
GOOGLE_MODELS=gemini-3.5-flash-lite

# --- Byte store (HF S3) ---
HF_S3_BUCKET=kelaska
HF_S3_ENDPOINT=https://s3.hf.co/<namespace>
HF_S3_REGION=us-east-1
HF_S3_ACCESS_KEY_ID=<hf-token-id>
HF_S3_SECRET_ACCESS_KEY=<hf-token-secret>
ASSET_BYTE_EGRESS=redirect

# --- Mode produksi on-demand ---
# Runner TIDAK boleh hidup di Vercel: function Hobby maksimal 300 detik.
OPENMAIC_GENERATION_RUNNER_ENABLED=false
OPENMAIC_AGENT_RUNTIME_ENABLED=false
NEXT_PUBLIC_WORKBENCH_ENABLED=false
NEXT_PUBLIC_ENABLE_VIDEO_EXPORT=false
NEXT_PUBLIC_DOCS_URL=https://docs.kelas.riau.ai

# --- Edge (dibagikan dengan branch deploy/cloudflare) ---
CRON_SECRET=<sama-dengan-wrangler-cron-secret>
MEDIA_TOKEN_SECRET=<sama-dengan-wrangler-media-secret>
WORKER_STATUS_ENDPOINT=https://api-kelas.riau.ai/worker/status

# --- Observability ---
SENTRY_DSN=<dsn>
SENTRY_ENVIRONMENT=production
